{
  "name": "dude",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @dude/client\" \"npm run dev:api:desktop\"",
    "dev:client": "npm run dev -w @dude/client",
    "dev:api": "npm run dev -w @dude/api",
    "dev:api:desktop": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs watch apps/api/src/index.ts",
    "rebuild:electron": "electron-rebuild -w better-sqlite3",
    "rebuild:sqlite:node": "npm rebuild better-sqlite3",
    "build": "npm run build -w @dude/sdk && npm run build -w @dude/client && npm run build -w @dude/api",
    "lint": "eslint packages --max-warnings 0",
    "lint:packages": "eslint packages --max-warnings 0",
    "build:sdk": "npm run build -w @dude/sdk",
    "electron:dev": "DUDE_DESKTOP_DEV_URL=http://127.0.0.1:5173 electron electron/main.cjs",
    "desktop:kill-stale": "sh -c 'lsof -ti :5173 | xargs kill 2>/dev/null || true'",
    "desktop:dev": "npm run generate:icons && npm run desktop:kill-stale && concurrently -k \"npm run dev -w @dude/client\" \"npm run dev:api:desktop\" \"DUDE_DESKTOP_DEV_URL=http://127.0.0.1:5173 electron electron/main.cjs\"",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "desktop:prepare": "npm run generate:icons && npm run build -w @dude/client",
    "desktop:local": "npm run desktop:prepare && DUDE_DESKTOP_FORCE_LOCAL=1 electron electron/main.cjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir",
    "desktop:dist": "npm run desktop:prepare && electron-builder",
    "postinstall": "patch-package && npm run rebuild:electron",
    "test": "NODE_OPTIONS='-r ts-node/register' jest",
    "generate:subagents": "node scripts/generate-subagent-packages.mjs",
    "ui:probe:document-writer": "node scripts/ui-harness/document-writer-probe.mjs",
    "agent": "node scripts/agent-harness/cli.mjs",
    "agent:status": "node scripts/agent-harness/cli.mjs status"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.33",
    "@ai-sdk/openai": "^3.0.36",
